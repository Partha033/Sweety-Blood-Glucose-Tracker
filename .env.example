# ==============================================================================
# Sweety – Blood Glucose Tracker Root Environment Configuration Example
# ==============================================================================
# Copy this file to individual .env files in server/ and client/ or use for Docker Compose

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/sweety_db

# Test Database Configuration
TEST_DB_NAME=sweety_test_db
TEST_DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/sweety_test_db

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_sweety_app_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Client Configuration
VITE_API_URL=http://localhost:5000/api
