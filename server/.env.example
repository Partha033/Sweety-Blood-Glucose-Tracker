NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Connection String or Individual Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=postgres

# Test Database
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_test_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_sweety_app_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
