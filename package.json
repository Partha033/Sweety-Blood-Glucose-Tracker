{
  "name": "sweety-blood-glucose-tracker",
  "version": "1.0.0",
  "description": "Sweety – Blood Glucose Tracker (MERN + PostgreSQL)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "node scripts/dev.js",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "test": "npm run test:server && npm run test:client",
    "build:client": "npm run build --prefix client",
    "lint:server": "npm run lint --prefix server",
    "lint:client": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "diabetes",
    "glucose-tracker",
    "react",
    "express",
    "postgresql",
    "jwt",
    "recharts",
    "tailwind"
  ],
  "author": "Sweety Engineering Team",
  "license": "MIT",
  "main": "index.js",
  "type": "commonjs"
}
